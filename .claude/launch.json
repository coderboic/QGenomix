{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "qgenomix-dashboard",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "streamlit", "run", "src/qgenomix/app/dashboard.py", "--server.port", "8501", "--server.headless", "true", "--browser.gatherUsageStats", "false"],
      "port": 8501
    },
    {
      "name": "qgenomix-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "qgenomix.app.api:app", "--port", "8000", "--app-dir", "src"],
      "port": 8000
    }
  ]
}
